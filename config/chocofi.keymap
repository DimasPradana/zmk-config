/*
 * Chocofi 36-key keymap. QWERTY base + GACS homerow mods.
 * Layers: 0 BASE, 1 LOWER, 2 RAISE, 3 ADJUST (LOWER+RAISE held together).
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
	keymap {
		compatible = "zmk,keymap";

		base_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
// | A/G | S/A | D/C | F/S |  G  |   |  H  |  J/S | K/C | L/A | ;/G |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
//                 | ESC | LWR | SPC |   | RET | RSE | BSPC |
			bindings = <
&kp Q    &kp W    &kp E    &kp R    &kp T     &kp Y &kp U &kp I &kp O &kp P
&mt LGUI A &mt LALT S &mt LCTRL D &mt LSHFT F &kp G   &kp H &mt RSHFT J &mt RCTRL K &mt RALT L &mt RGUI SEMI
&kp Z    &kp X    &kp C    &kp V    &kp B     &kp N &kp M &kp COMMA &kp DOT &kp FSLH
                &kp ESC &mo 1 &kp SPACE     &kp RET &mo 2 &kp BSPC
			>;
		};

		lower_layer {
// -----------------------------------------------------------------------------------------
// |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
// | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT | DEL |
// | BTCLR |            |            |   | HOME | PGDN | PGUP | END |     |
//                       | TAB |     | SPC |   | ENT |     |     |
			bindings = <
&kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL
&bt BT_CLR &trans &trans &trans &trans   &kp HOME &kp PGDN &kp PGUP &kp END &trans
                &kp TAB &trans &trans     &trans &trans &trans
			>;
		};

		raise_layer {
// -----------------------------------------------------------------------------------------
// |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
// | GUI | ALT | CTL | SFT |     |   |  `  |  '  | MUTE| V- | V+ |
// |  _  |  +  |  [  |  ]  |  |  |   |  ~  |     |     |     |     |
//                       |     |     |     |   |     |     | DEL |
			bindings = <
&kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR
&kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans    &kp GRAVE &kp SQT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP
&kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE   &kp TILDE &trans &trans &trans &trans
                              &trans &trans &trans     &trans &trans &kp DEL
			>;
		};

		adjust_layer {
// -----------------------------------------------------------------------------------------
// | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
// | F11 | F12 |     |     |     |   |     |     |     |     | UNLOCK |
// | BOOT|     |     |     |     |   |     |     |     |     | BOOT |
//                       |     |     |     |   |     |     |     |
			bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
&kp F11 &kp F12 &trans &trans &trans   &trans &trans &trans &trans &studio_unlock
&bootloader &trans &trans &trans &trans   &trans &trans &trans &trans &bootloader
                              &trans &trans &trans     &trans &trans &trans
			>;
		};
	};
};
